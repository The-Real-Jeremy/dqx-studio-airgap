From 4b0488f71d046bb887a65ecd998026b1c45172ac Mon Sep 17 00:00:00 2001
From: dqx-studio-airgap build <build@localhost>
Date: Wed, 21 Oct 2026 14:41:37 +1100
Subject: [PATCH 5/6] Air-gap build: allowed-values hint matches DQX 0.16
 semantics

DQX 0.16 reads a bare string in is_in_list / is_not_in_list as a column
expression; text literals must be quoted. Say so in the English hint.

---
 app/src/databricks_labs_dqx_app/ui/lib/i18n/locales/en.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/src/databricks_labs_dqx_app/ui/lib/i18n/locales/en.json b/app/src/databricks_labs_dqx_app/ui/lib/i18n/locales/en.json
index 18a791f3..f449c90b 100644
--- a/app/src/databricks_labs_dqx_app/ui/lib/i18n/locales/en.json
+++ b/app/src/databricks_labs_dqx_app/ui/lib/i18n/locales/en.json
@@ -886,7 +886,7 @@
     "argLabelMinValue": "Min Value",
     "argLabelMaxValue": "Max Value",
     "argHintColumnName": "e.g. id",
-    "argHintAllowed": "comma-separated, e.g. A,B,C",
+    "argHintAllowed": "comma-separated; quote text values, e.g. 'A', 'B' (an unquoted value is read as a column)",
     "argHintForbidden": "comma-separated",
     "argHintLimit": "numeric value",
     "argHintMinLimit": "min value",
-- 
